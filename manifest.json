{
  "manifest_version": 3,
  "name": "Clicktionary",
  "key": "",
  "version": "1.3",
  "description": "Highlight any word in 10 languages to get instant translations and build your personal word bank. Practice with flashcards & quizzes",
  "homepage_url": "https://samuelbingham07.github.io/clicktionarywebextension/",
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://incvqtbkfntzdvbingqv.supabase.co/*",
    "https://lingva.ml/*",
    "https://translate.plausibility.cloud/*",
    "https://lingva.thedaviddelta.com/*",
    "https://lingva.garudalinux.org/*",
    "https://api.mymemory.translated.net/*",
    "https://en.wiktionary.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clicktionary",
    "default_icon": {
      "16": "icon16.png",
      "48": "logo.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://samuelbingham07.github.io/*",
        "https://quizlet.com/*"
      ],
      "js": [
        "es-dict.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "https://samuelbingham07.github.io/clicktionarywebextension/*",
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "logo.png",
    "128": "icon128.png"
  }
}
